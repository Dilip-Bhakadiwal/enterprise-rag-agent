# ── LLM Providers ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_nim_key_here

# ── Vector Database (Pinecone) ────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_INDEX_NAME=enterprise-rag-demo
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Knowledge Graph (Neo4j AuraDB) ───────────────────────────────────────────
NEO4J_URI=neo4j+s://your_neo4j_instance_id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ── Dataset ──────────────────────────────────────────────────────────────────
DATASET_DOCS_PATH=Dataset/documents/test.parquet
DATASET_QUESTIONS_PATH=Dataset/questins/test (1).parquet

# ── Ingestion Settings ────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
UPSERT_BATCH_SIZE=100
MAX_DOCS=1500

# ── LLM Models ───────────────────────────────────────────────────────────────
PRIMARY_MODEL=meta-llama/llama-3.3-70b-instruct
GROQ_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
PRIMARY_BASE_URL=https://openrouter.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1

# ── App Settings ──────────────────────────────────────────────────────────────
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# ── Eval Settings ─────────────────────────────────────────────────────────────
RAGAS_EVAL_DELAY_SECONDS=3
RAGAS_SCORE_THRESHOLD=0.6

# ── Serverless Cache (Upstash Redis) ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ── LlamaParse & Ephemeral Doc RAG ──────────────────────────────────────────
LLAMAPARSE_API_KEY=your_llamaparse_api_key_here
MAX_DOC_PAGES=5
MAX_DOC_SIZE_BYTES=10485760
